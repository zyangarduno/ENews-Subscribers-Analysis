      }
    },
    {
      "cell_type": "markdown",
      "source": [
        "Now we will get the distortion for every different number of clusters to analyze the optimal cluster numbers by measuring the sum of square distance and error between each cluster vs the datapoints inside each cluster."
      ],
      "metadata": {
        "id": "qQ4DCOfZLjPV"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from sklearn.metrics import pairwise_distances"
      ],
      "metadata": {
        "id": "thHoaNQVu0gC"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "distortions = []\n",
        "K = range(2, 15)\n",
        "\n",
        "for k in K:\n",
        "    if k == 1:\n",
        "        distortions.append(0)\n",
        "    else:\n",
        "        clustering = AgglomerativeClustering(n_clusters=k, linkage='ward')\n",
        "        labels = clustering.fit_predict(subset_scaled_df)\n",
        "        centroids = np.array([subset_scaled_df[labels == i].mean(axis=0) for i in range(k)])\n",
        "        distortion = sum(np.min(pairwise_distances(subset_scaled_df, centroids), axis=1)**2)\n",
        "        distortions.append(distortion)\n",
        "\n",
        "plt.figure(figsize=(8, 5))\n",
        "plt.plot(K, distortions, marker='o', linestyle='--')\n",
        "plt.xlabel(\"Number of Clusters\")\n",
        "plt.ylabel(\"Distortion (Within-cluster Sum of Squares)\")\n",
        "plt.title(\"Elbow Method for Hierarchical Clustering\")\n",
        "plt.grid()\n",
        "plt.show()"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 485
